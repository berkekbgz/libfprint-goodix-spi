+static void
+warm_suspend_close_cb (GObject      *source_obj,
+                       GAsyncResult *res,
+                       gpointer      user_data)
+{
+  g_autoptr(GTask) task = user_data;
+  FprintDevice *rdev = g_task_get_source_object (task);
+  FprintDevicePrivate *priv = fprint_device_get_instance_private (rdev);
+  g_autoptr(GError) error = NULL;
+
+  priv->current_action = ACTION_NONE;
+  if (!fp_device_close_finish (FP_DEVICE (source_obj), res, &error))
+    {
+      g_task_return_error (task, g_steal_pointer (&error));
+      return;
+    }
+
+  priv->warm_closed_for_sleep = TRUE;
+  g_message ("Closed warm fingerprint device for suspend");
+  g_task_return_boolean (task, TRUE);
+}
+
+static void
+warm_resume_open_cb (GObject      *source_obj,
+                     GAsyncResult *res,
+                     gpointer      user_data)
+{
+  g_autoptr(GTask) task = user_data;
+  FprintDevice *rdev = g_task_get_source_object (task);
+  FprintDevicePrivate *priv = fprint_device_get_instance_private (rdev);
+  g_autoptr(GError) error = NULL;
+  g_autoptr(SessionData) session = NULL;
+  g_autoptr(GDBusMethodInvocation) invocation = NULL;
+
+  priv->current_action = ACTION_NONE;
+  if (!fp_device_open_finish (FP_DEVICE (source_obj), res, &error))
+    {
+      session = session_data_get (priv);
+      if (session && session->invocation)
+        {
+          g_autoptr(GError) dbus_error = NULL;
+
+          invocation = g_steal_pointer (&session->invocation);
+          dbus_error = g_error_new (FPRINT_ERROR,
+                                    FPRINT_ERROR_INTERNAL,
+                                    "Warm open failed with error: %s",
+                                    error->message);
+          g_dbus_method_invocation_return_gerror (invocation, dbus_error);
+          session_data_set_new (priv, NULL, NULL);
+        }
+      g_task_return_error (task, g_steal_pointer (&error));
+      return;
+    }
+
+  g_message ("Reopened warm fingerprint device after resume");
+  session = session_data_get (priv);
+  if (session && session->invocation)
+    {
+      invocation = g_steal_pointer (&session->invocation);
+      g_debug ("completing Claim that waited for post-resume prewarm");
+      fprint_dbus_device_complete_claim (FPRINT_DBUS_DEVICE (rdev), invocation);
+    }
+  g_task_return_boolean (task, TRUE);
+}
